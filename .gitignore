# Only workflow source and empty workspace directories belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/工作流说明.md
!/skill/
!/scripts/
!/Inbox/
!/raw/
!/final/
!/process/
!/package/
!/upload/

/Inbox/*
!/Inbox/.gitkeep
/raw/*
!/raw/.gitkeep
/final/*
!/final/.gitkeep
/process/*
!/process/.gitkeep
/package/*
!/package/.gitkeep
/upload/*
!/upload/.gitkeep
!/upload/published/
/upload/published/*
!/upload/published/.gitkeep

# Downloaded packages, models, fonts, caches: restore locally, never commit.
/scripts/vendor/*
!/scripts/vendor/.gitkeep
/scripts/models/*
!/scripts/models/.gitkeep
/scripts/fonts/*
!/scripts/fonts/.gitkeep
/scripts/cache/*
!/scripts/cache/.gitkeep
**/__pycache__/
*.py[cod]
*.log
*.tmp
*.part
.env
.env.*
*.pem
*.key
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.jpg
*.jpeg
*.png
*.webp
*.ttf
*.otf
*.ttc
*.bin
*.safetensors
*.whl
*.zip
*.7z
*.exe
*.dll
*.pyd
